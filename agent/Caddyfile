# TLS front end for the assistant's model server (scripts/run-agent.sh) and the
# GPU arbiter. Only clients holding a certificate from the assistant's private CA
# get in (mutual TLS): the assistant VM and the scout VM. The certificates come
# from homelab-foundation (`make assistant-pki`) into $AGENT_TLS_DIR.
#
# Started by agent/systemd/llm-agent-proxy.service (`make agent-setup`).
# Windows lets :8743 in from OPNsense's house address only (windows/setup.ps1).
{
	admin off
	auto_https off
	persist_config off
	# Clients dial the IP (https://192.168.0.12:8743), so they send no SNI. client_auth turns on
	# strict SNI/Host matching, which then answers 421; with a single site it guards nothing.
	servers {
		strict_sni_host insecure_off
	}
}

:8743 {
	tls {$AGENT_TLS_DIR}/server.crt {$AGENT_TLS_DIR}/server.key {
		protocols tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file {$AGENT_TLS_DIR}/ca.crt
		}
	}

	# GPU arbiter (scripts/arbiter.py): the VMs may read its status and ask for the model, nothing
	# else. /hold, /release and /stayon stay local (`llm desk|agent|stayon`): a VM must not be able
	# to keep the GPU from you or keep the PC from switching itself off.
	@arbiter path /arbiter/status /arbiter/request
	handle @arbiter {
		uri strip_prefix /arbiter
		reverse_proxy 127.0.0.1:8091
	}

	# The model: OpenAI-compatible API and health. Streaming answers pass straight through.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
			transport http {
				response_header_timeout 900s
			}
		}
	}
	handle /health {
		reverse_proxy 127.0.0.1:8090
	}

	# The owner's desk models, for the software factory's night work on the devbox: `llm code` (:8081) and
	# `llm 38` (:8082). Same client certificate rule as above. The factory only uses whichever model is already
	# serving; nothing here can load, switch or hold a model, and the arbiter still treats them as the owner's.
	@code path /code/v1/* /code/health
	handle @code {
		uri strip_prefix /code
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
			transport http {
				response_header_timeout 900s
			}
		}
	}
	@q38 path /38/v1/* /38/health
	handle @q38 {
		uri strip_prefix /38
		reverse_proxy 127.0.0.1:8082 {
			flush_interval -1
			transport http {
				response_header_timeout 900s
			}
		}
	}

	handle {
		respond 404
	}

	log {
		output file {$HOME}/.local/share/llama-logs/agent-proxy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
