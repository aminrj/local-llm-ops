[Unit]
Description=Free the GPU and pre-warm the Lookout agent LLM before the 06:00 radar queue
Wants=llm-agent-proxy.service
After=llm-agent-proxy.service

[Service]
Type=oneshot
Environment=CONF=%h/.config/llm-agent
# The desk servers (8081/8082/8083) hold the GPU indefinitely and the auto-off is
# blocked while Windows is signed in, so release the card here — but only when the
# desk is idle. desk-free.sh checks the log the running server writes to (any model):
# exit 0 = freed or already free, go on to pre-warm; exit 3 = a session is active,
# skip the pre-warm and leave it alone. The agent slot (:8090) is never touched.
SuccessExitStatus=3
ExecStart=/bin/bash -c '@REPO@/scripts/desk-free.sh && curl -sk --max-time 900 --cert "$CONF/lookout-client.crt" --key "$CONF/lookout-client.key" --cacert "$CONF/tls/ca.crt" -H "Authorization: Bearer $(cat "$CONF/api-key")" https://127.0.0.1:8743/v1/models'

[Install]
WantedBy=timers.target
